"""
End-to-end checks for the playwright toolchain.

The in-repo fixture holds two projects: `fixture` (served by the fixtures
module's static server) and `fixture/nested` (self-contained, no package.json
of its own).
"""
type E2e {
  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) { raise message }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  # Whether a check fails when run.
  let failed(check: Check!): Boolean! {
    check.pass == false
  }

  # The workspace with its working directory at the root, so keys and lookups
  # don't depend on where `dagger check` was invoked.
  let root(ws: Workspace!): Workspace! { ws.withWorkdir(".") }

  # The toolchain as the fixture project needs it: the fixture server wired
  # in, the localhost proxy on, and two shards.
  let wired: Playwright! {
    playwright(service: fixtures.server, localhostProxy: true, shards: 2)
  }

  """
  Run the fixture project with a bound service, the localhost proxy and two shards.
  """
  checkFixture(ws: Workspace!): Void @check {
    let w = root(ws)
    let project = wired.projects(w).get(key: "fixture")
    let ctr = project.base(w)
    assert(
      ctr.envVariable("PLAYWRIGHT_BASE_URL") == "http://frontend:8080",
      "PLAYWRIGHT_BASE_URL does not point at the bound service",
    )
    assert(
      ctr.envVariable("PLAYWRIGHT_LOCALHOST_BASE_URL") == "http://localhost:8080",
      "PLAYWRIGHT_LOCALHOST_BASE_URL is not set",
    )
    # The whole project runs natively, one container per shard.
    let shards = project.runs.{{shard, files}}
    assert(
      shards.map { r => r.shard }.join(",") == "1/2,2/2",
      "a whole run is not one run per shard: " + shards.map { r => r.shard }.join(","),
    )
    project.test(w)
    null
  }

  """
  Discovery keys projects by config directory, scoped by the working directory.
  """
  discoveryCheck(ws: Workspace!): Void @check {
    let w = root(ws)
    let keys = playwright.projects(w).keys.join(",")
    assert(keys == "fixture,fixture/nested", "unexpected keys from the root: " + keys)

    let synthetic = w
      .withNewFile("synthetic/b/playwright.config.mjs", "")
      .withNewFile("synthetic/a/playwright.config.cts", "")
      .withNewFile("synthetic/a/playwright.config.ts", "")
      .withNewFile("fixture/node_modules/dep/playwright.config.js", "")
      .withNewFile("fixture/.cache/playwright.config.ts", "")
    let all = playwright.projects(synthetic).keys.join(",")
    assert(
      all == "fixture,fixture/nested,synthetic/a,synthetic/b",
      "unexpected keys in a synthetic workspace: " + all,
    )

    # At a project root: that project and the ones below it, no ancestors.
    let atRoot = playwright.projects(w.withWorkdir("fixture")).keys.join(",")
    assert(atRoot == "fixture,fixture/nested", "unexpected keys from fixture: " + atRoot)
    let nested = playwright.projects(w.withWorkdir("fixture/nested")).keys.join(",")
    assert(nested == "fixture/nested", "discovery from a project escaped its subtree: " + nested)

    # Inside a project's subdirectory: exactly the enclosing project.
    let inside = playwright.projects(w.withWorkdir("fixture/tests")).keys.join(",")
    assert(inside == "fixture", "discovery inside a project missed its enclosing config: " + inside)
    let deeper = playwright.projects(w.withWorkdir("fixture/nested/tests")).keys.join(",")
    assert(deeper == "fixture/nested", "discovery did not pick the nearest enclosing project: " + deeper)

    # Outside any project: only the projects below.
    let outside = playwright.projects(synthetic.withWorkdir("synthetic")).keys.join(",")
    assert(outside == "synthetic/a,synthetic/b", "unexpected keys outside any project: " + outside)
    let none = playwright.projects(w.withWorkdir(".dagger")).keys.length
    assert(none == 0, "found projects where there are none")

    # Test files are keyed relative to their project, whatever the cwd.
    let files = playwright.projects(w).get(key: "fixture").tests(w).keys.join(",")
    assert(files == "tests/smoke.spec.ts", "unexpected test files in fixture: " + files)
    let deep = w.withWorkdir("fixture/tests")
    let fromTests = playwright.projects(deep).get(key: "fixture").tests(deep).keys.join(",")
    assert(fromTests == files, "test file keys depend on the cwd: " + fromTests)
    let nestedFiles = playwright.projects(w).get(key: "fixture/nested").tests(w).keys.join(",")
    assert(nestedFiles == "tests/nested.spec.ts", "unexpected test files in fixture/nested: " + nestedFiles)
    null
  }

  """
  The project lookup resolves the project containing a path.
  """
  lookupCheck(ws: Workspace!): Void @check {
    let w = root(ws)
    assert(playwright.project(w, "fixture/tests").path == "fixture", "lookup missed the enclosing project")
    assert(playwright.project(w, "fixture/nested").path == "fixture/nested", "lookup missed the nearest project")
    assert(
      playwright.project(w.withWorkdir("fixture"), "nested").path == "fixture/nested",
      "lookup did not resolve relative to the working directory",
    )
    assert(
      playwright.project(w.withWorkdir("fixture/nested"), "/fixture").path == "fixture",
      "lookup did not resolve an absolute path from the workspace root",
    )
    let missing = {
      playwright.project(w, ".").path
    } rescue {
      err: Error => err.message
    }
    assert(missing.contains("no playwright.config"), "missing project did not fail clearly: " + missing)
    null
  }

  """
  Dependencies install from the nearest package.json, which also picks the image.
  """
  installCheck(ws: Workspace!): Void @check {
    let w = root(ws)
    let projects = playwright.projects(w)
    let image = "mcr.microsoft.com/playwright:v1.58.2-noble"
    assert(projects.get(key: "fixture").installDir(w) == "fixture", "fixture installs elsewhere")
    assert(
      projects.get(key: "fixture/nested").installDir(w) == "fixture",
      "nested project does not install from the enclosing package.json",
    )
    assert(projects.get(key: "fixture/nested").imageAddress(w) == image, "nested image not derived")
    let bare = w.withNewFile("synthetic/playwright.config.ts", "")
    assert(
      playwright.projects(bare).get(key: "synthetic").installDir(bare) == null,
      "invented an install dir",
    )
    assert(
      playwright(baseImageAddress: "example.com/pw:1").project(w, "fixture").imageAddress(w) == "example.com/pw:1",
      "baseImageAddress was not honored",
    )
    null
  }

  """
  The projects and test-file collections support get and subset, and their
  plain test functions run just the selection.
  """
  collectionCheck(ws: Workspace!): Void @check {
    let w = root(ws)
    # Unwired: `fixture` needs the server and fails, `fixture/nested` doesn't.
    let projects = playwright.projects(w)
    let only = projects.subset(keys: ["fixture/nested"])
    assert(only.keys.join(",") == "fixture/nested", "subset kept other keys")
    assert(only.get(key: "fixture/nested").path == "fixture/nested", "get inside a subset failed")
    let outside = {
      only.get(key: "fixture").path
    } rescue {
      err: Error => "rejected"
    }
    assert(outside == "rejected", "get outside a subset succeeded")
    let unknown = {
      projects.subset(keys: ["nope"]).keys.join(",")
    } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "subset accepted an unknown key")
    let duplicate = {
      projects.subset(keys: ["fixture", "fixture"]).keys.join(",")
    } rescue {
      err: Error => "rejected"
    }
    assert(duplicate == "rejected", "subset accepted a duplicate key")
    let empty: [String!]! = []
    assert(projects.subset(keys: empty).keys.length == 0, "empty subset is not empty")

    # The failing project is outside the subset, so this passes only if the
    # subset ran just its own keys.
    only.test(w)

    # The whole collection reports the failing project, and only it.
    let failure = {
      projects.test(w)
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(failure.contains("- fixture:"), "test did not report the failing project: " + failure)
    assert(failure.contains("- fixture/nested:") == false, "test reported a passing project: " + failure)

    # With every project failing, test reports all of them.
    let both = {
      playwright(args: ["--bogus-option"]).projects(w).test(w)
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(
      both.contains("- fixture:") and both.contains("- fixture/nested:"),
      "test did not report every failing project: " + both,
    )

    # The test files of a project are a collection too.
    let tests = synthetic.projects(syntheticWs).get(key: "defaults").tests(syntheticWs)
    assert(tests.keys.join(",") == "a.spec.ts,b.test.mjs,sub/d.spec.tsx", "unexpected keys: " + tests.keys.join(","))
    let pair = tests.subset(keys: ["sub/d.spec.tsx", "a.spec.ts"])
    assert(pair.keys.join(",") == "a.spec.ts,sub/d.spec.tsx", "subset did not keep collection order: " + pair.keys.join(","))
    assert(pair.get(key: "a.spec.ts").path == "a.spec.ts", "get inside a subset failed")
    let outsideFile = {
      pair.get(key: "b.test.mjs").path
    } rescue {
      err: Error => "rejected"
    }
    assert(outsideFile == "rejected", "get outside a subset succeeded")
    let unknownFile = {
      tests.subset(keys: ["nope.spec.ts"]).keys.join(",")
    } rescue {
      err: Error => "rejected"
    }
    assert(unknownFile == "rejected", "subset accepted an unknown test file")
    let duplicateFile = {
      tests.subset(keys: ["a.spec.ts", "a.spec.ts"]).keys.join(",")
    } rescue {
      err: Error => "rejected"
    }
    assert(duplicateFile == "rejected", "subset accepted a duplicate test file")
    let noFiles = tests.subset(keys: empty)
    assert(noFiles.keys.length == 0, "empty subset is not empty")
    assert(noFiles.runs.{{shard}}.length == 0, "an empty subset plans runs")
    noFiles.test(syntheticWs)
    null
  }

  """
  The projects' test function tests every project against the wired service,
  and report works.
  """
  projectsCheck(ws: Workspace!): Void @check {
    let w = root(ws)
    wired.projects(w).test(w)
    let report = playwright.project(w, "fixture").report(w)
    assert(report.entries.contains("index.html"), "report has no index.html")
    null
  }

  # A small synthetic workspace of projects, one per config-reading rule.
  # Search skips empty files, so every file has content.
  let syntheticWs: Workspace! {
    let body = "export {};\n"
    directory
      # Defaults: testDir is the config directory, the default testMatch, no
      # node_modules, and a nested project keeps its own files.
      .withNewFile("defaults/playwright.config.ts", "export default {};\n")
      .withNewFile("defaults/a.spec.ts", body)
      .withNewFile("defaults/b.test.mjs", body)
      .withNewFile("defaults/c.ts", body)
      .withNewFile("defaults/sub/d.spec.tsx", body)
      .withNewFile("defaults/node_modules/x/e.spec.ts", body)
      .withNewFile("defaults/inner/playwright.config.js", "module.exports = {};\n")
      .withNewFile("defaults/inner/f.spec.js", body)
      # A literal testDir.
      .withNewFile(
        "testdir/playwright.config.ts",
        "import { defineConfig } from '@playwright/test';\n// testDir: 'nope'\nexport default defineConfig({\n  testDir: './e2e',\n  use: { baseURL: 'http://x:1/' },\n});\n",
      )
      .withNewFile("testdir/e2e/a.spec.ts", body)
      .withNewFile("testdir/other/b.spec.ts", body)
      # path.join(__dirname, ...).
      .withNewFile(
        "joined/playwright.config.ts",
        "import path from 'path';\nexport default defineConfig({ testDir: path.join(__dirname, 'e2e') });\n",
      )
      .withNewFile("joined/e2e/a.spec.ts", body)
      .withNewFile("joined/b.spec.ts", body)
      # A testMatch glob.
      .withNewFile("glob/playwright.config.ts", "export default defineConfig({ testMatch: '*.e2e.ts' });\n")
      .withNewFile("glob/x.e2e.ts", body)
      .withNewFile("glob/y.spec.ts", body)
      # A testMatch array of a glob and a regex.
      .withNewFile(
        "array/playwright.config.ts",
        "export default defineConfig({ testMatch: ['a/*.ts', /b\\.check\\.js$/] });\n",
      )
      .withNewFile("array/a/one.ts", body)
      .withNewFile("array/a/deep/two.ts", body)
      .withNewFile("array/b.check.js", body)
      .withNewFile("array/c.spec.ts", body)
      # A testMatch regex.
      .withNewFile("regex/playwright.config.js", "module.exports = { testMatch: /.*\\.pw\\.ts$/i };\n")
      .withNewFile("regex/x.PW.ts", body)
      .withNewFile("regex/y.spec.ts", body)
      # testIgnore.
      .withNewFile("ignored/playwright.config.ts", "export default defineConfig({ testIgnore: '**/skip/**' });\n")
      .withNewFile("ignored/a.spec.ts", body)
      .withNewFile("ignored/skip/b.spec.ts", body)
      # Playwright projects with their own testDir: keys are the union.
      .withNewFile(
        "projects/playwright.config.ts",
        "export default defineConfig({\n  testDir: 'shared',\n  projects: [\n    { name: 'a', use: { ...devices['Desktop Chrome'] } },\n    { name: 'b', testDir: './b-tests' },\n  ],\n});\n",
      )
      .withNewFile("projects/shared/s.spec.ts", body)
      .withNewFile("projects/b-tests/t.spec.ts", body)
      .withNewFile("projects/other/o.spec.ts", body)
      # Non-literal values fall back to the defaults.
      .withNewFile(
        "dynamic/playwright.config.ts",
        "const dir = process.env.DIR;\nexport default defineConfig({ testDir: dir, testMatch: process.env.MATCH });\n",
      )
      .withNewFile("dynamic/a.spec.ts", body)
      .withNewFile("dynamic/e2e/b.spec.ts", body)
      # A regex RE2 can't compile falls back to the default testMatch.
      .withNewFile("lookaround/playwright.config.ts", "export default defineConfig({ testMatch: /(?<=x)y\\.ts/ });\n")
      .withNewFile("lookaround/a.spec.ts", body)
      .withNewFile("lookaround/xy.ts", body)
      # A config that isn't JavaScript falls back to the defaults.
      .withNewFile("broken/playwright.config.ts", "this is {{ not ( javascript\n")
      .withNewFile("broken/a.spec.ts", body)
      # SvelteKit's shapes: a shared config in ../../utils.js, spread into
      # defineConfig({...config, webServer}) or re-exported as the default.
      .withNewFile(
        "kit/test/utils.js",
        "import { defineConfig } from '@playwright/test';\nexport const port = 4173;\nif (!port) throw new Error(`no port for ${process.env.NAME}`);\n// a comment that doesn't close a `template`\nexport const config = defineConfig({\n  forbidOnly: !!process.env.CI,\n  projects: process.env.P ? all.filter((p) => p) : all,\n  reporter: 'list',\n  testDir: 'test',\n  testMatch: /(.+\\.)?(test|spec)\\.[jt]s/\n});\n",
      )
      .withNewFile(
        "kit/test/apps/basics/playwright.config.js",
        "import process from 'node:process';\nimport { config, port } from '../../utils.js';\nimport { defineConfig } from '@playwright/test';\n\nexport default defineConfig({\n\t...config,\n\twebServer: {\n\t\t...config.webServer,\n\t\tcommand: process.env.DEV ? `pnpm dev --port ${port}` : 'pnpm preview',\n\t\tport\n\t}\n});\n",
      )
      .withNewFile("kit/test/apps/basics/test/client.test.js", body)
      .withNewFile("kit/test/apps/basics/test/test.js", body)
      .withNewFile("kit/test/apps/basics/src/build.test.js", body)
      .withNewFile(
        "kit/test/apps/adapter/playwright.config.js",
        "export { config as default } from '../../utils.js';\n",
      )
      .withNewFile("kit/test/apps/adapter/test/test.js", body)
      .withNewFile("kit/test/apps/adapter/src/unit.spec.js", body)
      .withNewFile(
        "kit/test/apps/override/playwright.config.js",
        "import { config as base } from '../../utils.js';\nexport default {\n  ...base,\n  testIgnore: '**/skip/**',\n};\n",
      )
      .withNewFile("kit/test/apps/override/test/a.test.js", body)
      .withNewFile("kit/test/apps/override/test/skip/b.test.js", body)
      # React Router's shape: a typed const exported by name.
      .withNewFile(
        "rr/integration/playwright.config.ts",
        "import type { PlaywrightTestConfig } from '@playwright/test';\nlet workers = 2;\nconst config: PlaywrightTestConfig = {\n  testDir: '.',\n  testMatch: ['**/*-test.ts'],\n  timeout: 30_000,\n  workers,\n  projects: [\n    { name: 'chromium', use: devices['Desktop Chrome'] },\n    { name: 'msedge', use: { ...devices['Desktop Edge'], channel: 'msedge' } },\n  ],\n};\n\nexport default config;\n",
      )
      .withNewFile("rr/integration/a-test.ts", body)
      .withNewFile("rr/integration/helpers/b-test.ts", body)
      .withNewFile("rr/integration/c.spec.ts", body)
      # A const bound to a literal is read through its name.
      .withNewFile(
        "named/playwright.config.ts",
        "const match: string[] = ['**/*.e2e.ts', /\\.pw\\.js$/];\nexport const dir = 'e2e'\nexport default defineConfig({ testDir: dir, testMatch: match });\n",
      )
      .withNewFile("named/e2e/a.e2e.ts", body)
      .withNewFile("named/e2e/b.pw.js", body)
      .withNewFile("named/e2e/c.spec.ts", body)
      .withNewFile("named/d.e2e.ts", body)
      # Nothing to find statically: the project has no keys, not an invented
      # one, so it offers no checks.
      .withNewFile(
        "opaque/playwright.config.ts",
        "export default defineConfig({ testMatch: process.env.MATCH ?? '**/*.e2e.ts' });\n",
      )
      .withNewFile("opaque/a.e2e.ts", body)
      .asWorkspace
  }

  let synthetic: Playwright! { playwright }

  """
  Test files follow the literal testDir, testMatch and testIgnore in each config.
  """
  configCheck: Void @check {
    let ws = syntheticWs
    let projects = synthetic.projects(ws)
    let expect(project: String!, want: String!): Void {
      let got = projects.get(key: project).tests(ws).keys.join(",")
      assert(got == want, project + ": got " + got + ", want " + want)
    }
    expect("defaults", "a.spec.ts,b.test.mjs,sub/d.spec.tsx")
    expect("defaults/inner", "f.spec.js")
    expect("testdir", "e2e/a.spec.ts")
    expect("joined", "e2e/a.spec.ts")
    expect("glob", "x.e2e.ts")
    expect("array", "a/one.ts,b.check.js")
    expect("regex", "x.PW.ts")
    expect("ignored", "a.spec.ts")
    expect("projects", "b-tests/t.spec.ts,shared/s.spec.ts")
    expect("dynamic", "a.spec.ts,e2e/b.spec.ts")
    expect("lookaround", "a.spec.ts")
    expect("broken", "a.spec.ts")
    expect("kit/test/apps/basics", "test/client.test.js,test/test.js")
    expect("kit/test/apps/adapter", "test/test.js")
    expect("kit/test/apps/override", "test/a.test.js")
    expect("rr/integration", "a-test.ts,helpers/b-test.ts")
    expect("named", "e2e/a.e2e.ts,e2e/b.pw.js")
    expect("opaque", "")

    # Keys don't depend on the cwd.
    let inside = ws.withWorkdir("testdir/e2e")
    let fromInside = synthetic.projects(inside).get(key: "testdir").tests(inside).keys.join(",")
    assert(fromInside == "e2e/a.spec.ts", "keys changed with the cwd: " + fromInside)
    null
  }

  # A project whose tests need no browser or service: a.spec.ts passes and
  # aa.spec.ts fails (a filter for "a.spec.ts" alone would also match it),
  # b, c and d pass.
  let runWs: Workspace! {
    let pass = "import { test, expect } from '@playwright/test';\ntest('passes', () => { expect(1).toBe(1); });\n"
    let fail = "import { test, expect } from '@playwright/test';\ntest('fails', () => { expect(1).toBe(2); });\n"
    directory
      .withNewFile(
        "runs/package.json",
        "{ \"name\": \"runs\", \"private\": true, \"devDependencies\": { \"@playwright/test\": \"1.58.2\" } }\n",
      )
      .withNewFile("runs/playwright.config.ts", "import { defineConfig } from '@playwright/test';\nexport default defineConfig({ testDir: 'tests' });\n")
      .withNewFile("runs/tests/a.spec.ts", pass)
      .withNewFile("runs/tests/aa.spec.ts", fail)
      .withNewFile("runs/tests/b.spec.ts", pass)
      .withNewFile("runs/tests/c.spec.ts", pass)
      .withNewFile("runs/tests/d.spec.ts", pass)
      # A reporter that says it ran and fails the run, which no test does.
      .withNewFile(
        "runs/reporter.js",
        "module.exports = class { printsToStdio() { return true; } onEnd() { console.log('custom reporter ran'); return { status: 'failed' }; } };\n",
      )
      # Its testMatch is a const, read through the name.
      .withNewFile(
        "runs/whole/playwright.config.ts",
        "import { defineConfig } from '@playwright/test';\nconst match = '**/*.e2e.ts';\nexport default defineConfig({ testMatch: match });\n",
      )
      .withNewFile("runs/whole/a.e2e.ts", pass)
      # Found by nothing static: no keys, and its plain test still runs it.
      .withNewFile(
        "runs/opaque/playwright.config.ts",
        "import { defineConfig } from '@playwright/test';\nexport default defineConfig({ testMatch: process.env.MATCH ?? '**/*.e2e.ts' });\n",
      )
      .withNewFile("runs/opaque/a.e2e.ts", fail)
      .asWorkspace
  }

  """
  Filtered runs select exactly their files in groups, and each file's check
  reads only its own result; whole runs shard the project.
  """
  runCheck: Void @check {
    let ws = runWs
    let tests = playwright(shards: 2).projects(ws).get(key: "runs").tests(ws)
    let a = "tests/a.spec.ts"
    let aa = "tests/aa.spec.ts"
    assert(
      tests.keys.join(",") == "tests/a.spec.ts,tests/aa.spec.ts,tests/b.spec.ts,tests/c.spec.ts,tests/d.spec.ts",
      "unexpected keys: " + tests.keys.join(","),
    )

    # Exactly one file, though its name is a substring of a failing one.
    let justA = tests.subset(keys: [a])
    justA.test(ws)
    run(tests.get(key: a).test(ws, selection: justA))
    let justAa = tests.subset(keys: [aa])
    assert(failed(tests.get(key: aa).test(ws, selection: justAa)), "the failing file passed on its own")

    # Sharing a run, each file's check reads only its own result.
    let pair = tests.subset(keys: [a, aa])
    run(tests.get(key: a).test(ws, selection: pair))
    assert(failed(tests.get(key: aa).test(ws, selection: pair)), "the failing file passed in a shared run")
    let outside = failure(tests.get(key: "tests/b.spec.ts").test(ws, selection: pair))
    assert(outside.contains("outside the selection"), "a file outside the selection was not refused: " + outside)

    # More files than shards: two groups, in order, each its own container.
    let three = tests.subset(keys: [a, "tests/b.spec.ts", "tests/c.spec.ts"])
    let groups = three.runs.{{files, shard}}.map { r => r.files.join("+") }.join(" | ")
    assert(groups == "tests/a.spec.ts+tests/b.spec.ts | tests/c.spec.ts", "unexpected groups: " + groups)
    three.test(ws)

    # A failing file is reported, and only that file.
    let failing = {
      pair.test(ws)
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(failing.contains("- tests/aa.spec.ts:"), "the failing file was not reported: " + failing)
    assert(failing.contains("- tests/a.spec.ts:") == false, "a passing file was reported: " + failing)
    assert(failing.contains("expect(received).toBe(expected)"), "the failure lost its error: " + failing)

    # The reporters setting replaces list: this reporter fails the run and
    # says so, which only shows when it is used.
    let custom = failure(
      playwright(reporters: ["./reporter.js"]).projects(ws).get(key: "runs").tests(ws).get(key: a).test(ws, selection: justA),
    )
    assert(custom.contains("custom reporter ran"), "the reporters setting was not used: " + custom)

    # The whole run is one container per shard, and it fails.
    let project = playwright(shards: 2).projects(ws).get(key: "runs")
    let whole = project.runs.{{files, shard}}
    assert(
      whole.map { r => r.shard }.join(",") == "1/2,2/2",
      "a whole run is not one run per shard: " + whole.map { r => r.shard }.join(","),
    )
    let wholeFailure = {
      project.test(ws)
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(
      wholeFailure.contains("- tests/aa.spec.ts:") and wholeFailure.contains("- tests/a.spec.ts:") == false,
      "the whole run did not blame just the failing file: " + wholeFailure,
    )

    # A testMatch bound to a const finds its file, which runs.
    let named = playwright.projects(ws).get(key: "runs/whole").tests(ws)
    assert(named.keys.join(",") == "a.e2e.ts", "unexpected keys: " + named.keys.join(","))
    run(named.get(key: "a.e2e.ts").test(ws, selection: named))

    # A project without keys offers no checks, and test runs it whole.
    let opaque = playwright.projects(ws).get(key: "runs/opaque")
    assert(opaque.tests(ws).keys.length == 0, "invented keys: " + opaque.tests(ws).keys.join(","))
    let opaqueFailure = {
      opaque.test(ws)
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(opaqueFailure.contains("a.e2e.ts"), "the keyless project's failure was lost: " + opaqueFailure)

    # report adds the html reporter, which this config doesn't configure.
    let report = playwright.projects(ws).get(key: "runs").report(ws)
    assert(report.entries.contains("index.html"), "report has no index.html")
    null
  }

  # A file's text for a synthetic workspace.
  let packageJson(fields: String!): String! {
    "{ \"private\": true" + fields + " }\n"
  }

  """
  Package manager, install root and Playwright version come from the
  workspace: packageManager fields, lockfiles and pnpm catalogs.
  """
  imageCheck: Void @check {
    let config = "export default {};\n"
    let ws = directory
      # A pnpm workspace whose app takes @playwright/test from the catalog.
      .withNewFile("pnpm/package.json", packageJson(", \"packageManager\": \"pnpm@9.15.0\""))
      .withNewFile(
        "pnpm/pnpm-workspace.yaml",
        "packages:\n  - 'apps/*'\ncatalog:\n  '@playwright/test': ^1.60.0\n  vite: ^7.0.0\ncatalogs:\n  e2e:\n    '@playwright/test': 1.59.1\n",
      )
      .withNewFile("pnpm/apps/web/package.json", packageJson(", \"devDependencies\": { \"@playwright/test\": \"catalog:\" }"))
      .withNewFile("pnpm/apps/web/playwright.config.ts", config)
      .withNewFile("pnpm/apps/named/package.json", packageJson(", \"devDependencies\": { \"@playwright/test\": \"catalog:e2e\" }"))
      .withNewFile("pnpm/apps/named/playwright.config.ts", config)
      # The same, locked: the lockfile's version wins, even for an app that
      # doesn't declare @playwright/test itself.
      .withNewFile("locked/package.json", packageJson(", \"devDependencies\": { \"@playwright/test\": \"catalog:\" }"))
      .withNewFile("locked/pnpm-workspace.yaml", "packages:\n  - 'apps/*'\ncatalog:\n  '@playwright/test': ^1.62.1\n")
      .withNewFile(
        "locked/pnpm-lock.yaml",
        "lockfileVersion: '9.0'\nimporters:\n  .:\n    devDependencies:\n      '@playwright/test':\n        specifier: 'catalog:'\n        version: 1.63.0\npackages:\n  '@playwright/test@1.63.0':\n    resolution: {integrity: sha512-x}\n",
      )
      .withNewFile("locked/apps/site/package.json", packageJson(""))
      .withNewFile("locked/apps/site/playwright.config.ts", config)
      # yarn.lock and a workspaces field.
      .withNewFile("yarn/package.json", packageJson(", \"workspaces\": [\"e2e\"]"))
      .withNewFile(
        "yarn/yarn.lock",
        "\"@playwright/test@npm:^1.50.0\":\n  version: 1.50.1\n  resolution: \"@playwright/test@npm:1.50.1\"\n",
      )
      .withNewFile("yarn/e2e/package.json", packageJson(", \"devDependencies\": { \"@playwright/test\": \"^1.50.0\" }"))
      .withNewFile("yarn/e2e/playwright.config.ts", config)
      # A specifier that is no version at all falls back cleanly.
      .withNewFile("odd/package.json", packageJson(", \"devDependencies\": { \"@playwright/test\": \"workspace:*\" }"))
      .withNewFile("odd/playwright.config.ts", config)
      .asWorkspace
    let projects = playwright.projects(ws)
    let check(key: String!, root: String!, pm: String!, image: String!): Void {
      let project = projects.get(key: key)
      let gotRoot = project.installDir(ws) ?? "none"
      assert(gotRoot == root, key + ": install root " + gotRoot + ", want " + root)
      let gotPm = project.packageManager(ws)
      assert(gotPm == pm, key + ": package manager " + gotPm + ", want " + pm)
      let gotImage = project.imageAddress(ws)
      assert(gotImage == image, key + ": image " + gotImage + ", want " + image)
    }
    let pw = "mcr.microsoft.com/playwright:v"
    check("pnpm/apps/web", "pnpm", "pnpm", pw + "1.60.0-noble")
    check("pnpm/apps/named", "pnpm", "pnpm", pw + "1.59.1-noble")
    check("locked/apps/site", "locked", "pnpm", pw + "1.63.0-noble")
    check("yarn/e2e", "yarn", "yarn", pw + "1.50.1-noble")
    check("odd", "odd", "npm", pw + "1.58.2-noble")
    assert(
      playwright(packageManager: "bun").projects(ws).get(key: "yarn/e2e").packageManager(ws) == "bun",
      "the packageManager setting did not win",
    )
    null
  }

  # Failure text of a check, or "passed".
  let failure(check: Check!): String! {
    if (check.pass) { "passed" } else { check.error.message ?? "failed" }
  }

  """
  Installs use pnpm via corepack, copy file: deps, link bins, name failures; environment applies.
  """
  installRunCheck: Void @check {
    let pass = "import { test, expect } from '@playwright/test';\ntest('env', () => { expect(process.env.GREETING).toBe('hello=world'); });\n"
    let usesBin = "import { test, expect } from '@playwright/test';\nimport { execFileSync } from 'node:child_process';\ntest('bin', () => { expect(execFileSync('node_modules/.bin/greet').toString().trim()).toBe('hi from tool'); });\n"
    let usesDep = "import { test, expect } from '@playwright/test';\nimport dep from 'local-dep';\ntest('dep', () => { expect(dep.answer).toBe(42); });\n"
    let ws = directory
      # pnpm workspace, with @playwright/test from the catalog.
      .withNewFile("pnpm/package.json", packageJson(", \"packageManager\": \"pnpm@9.15.0\""))
      .withNewFile(
        "pnpm/pnpm-workspace.yaml",
        "packages:\n  - 'apps/*'\n  - 'packages/*'\ncatalog:\n  '@playwright/test': 1.58.2\n",
      )
      # A workspace package with a bin, which the install must see to link.
      .withNewFile(
        "pnpm/packages/tool/package.json",
        "{ \"name\": \"tool\", \"version\": \"1.0.0\", \"bin\": { \"greet\": \"bin/greet.js\" } }\n",
      )
      .withNewFile("pnpm/packages/tool/bin/greet.js", "#!/usr/bin/env node\nconsole.log('hi from tool');\n")
      .withNewFile("pnpm/apps/web/bin.spec.ts", usesBin)
      .withNewFile(
        "pnpm/apps/web/package.json",
        packageJson(
          ", \"devDependencies\": { \"@playwright/test\": \"catalog:\", \"local-dep\": \"file:./local-dep\", \"tool\": \"workspace:*\" }",
        ),
      )
      .withNewFile("pnpm/apps/web/playwright.config.ts", "export default {};\n")
      .withNewFile("pnpm/apps/web/env.spec.ts", pass)
      # pnpm copies file: dependencies at install time, so the install needs
      # the directory, not only its package.json.
      .withNewFile("pnpm/apps/web/local-dep/package.json", "{ \"name\": \"local-dep\", \"version\": \"1.0.0\", \"main\": \"index.js\" }\n")
      .withNewFile("pnpm/apps/web/local-dep/index.js", "module.exports = { answer: 42 };\n")
      .withNewFile("pnpm/apps/web/dep.spec.ts", usesDep)
      # No @playwright/test, and a postinstall that fails.
      .withNewFile("bare/package.json", packageJson(", \"scripts\": { \"postinstall\": \"exit 3\" }"))
      .withNewFile("bare/playwright.config.ts", "export default {};\n")
      .withNewFile("bare/a.spec.ts", pass)
      .asWorkspace
    let tool = playwright(environment: ["GREETING=hello=world"])
    tool.projects(ws).get(key: "pnpm/apps/web").tests(ws).test(ws)

    let broken = {
      tool.projects(ws).get(key: "bare").tests(ws).test(ws)
      "passed"
    } rescue {
      err: Error => err.message
    }
    assert(broken.contains("install failed (npm install, exit"), "the install failure was not named: " + broken)
    let missing = {
      playwright(installFlags: ["--ignore-scripts"]).projects(ws).get(key: "bare").tests(ws).test(ws)
      "passed"
    } rescue {
      err: Error => err.message
    }
    assert(
      missing.contains("@playwright/test is not installed"),
      "a project without Playwright did not fail clearly: " + missing,
    )
    null
  }

  # Only the unindented CHECKS header counts: nested TESTS summaries count
  # Playwright's tests, not Dagger's checks.
  let checkSummaryMatches(output: String!, passed: Int!, failed: Int!): Boolean! {
    let headers = output.split("\n").filter { line =>
      line.hasPrefix("CHECKS ") or line.hasPrefix("== CHECKS ==")
    }
    let expected = (if (failed > 0) { ["✘", `${failed}`, "failed"] } else { [] })
      + (if (passed > 0) { ["✔", `${passed}`, "passed"] } else { [] })
    let words = (headers[0] ?? "").trimPrefix("== ").trimPrefix("CHECKS").trimPrefix(" ==").trimSpace.split(" ").filter { word =>
      word != ""
    }
    headers.length == 1 and words == expected
  }

  """
  The check-summary parser counts only the top-level CHECKS header.
  """
  selectedSummaryCheck: Void @check {
    let nested = "CHECKS  ✘ 4 failed\n  TESTS\n    ✘ 1 failed\n    ✔ 3 passed\n"
    assert(checkSummaryMatches(nested, 3, 1) == false, "nested test counts hid failed checks")
    assert(checkSummaryMatches(nested, 0, 4), "zero passing checks were not recognized")
    assert(checkSummaryMatches("== CHECKS ==  ✘ 1 failed  ✔ 3 passed\n", 3, 1), "the report header was not recognized")
    assert(checkSummaryMatches("CHECKS  ✔ 14 passed\n", 4, 0) == false, "accepted a partial count")
    assert(checkSummaryMatches("  CHECKS  ✔ 4 passed\n", 4, 0) == false, "accepted a nested header")
    null
  }

  # Run `dagger check` on a fixture workspace that installs this module, and
  # return its exit status and output. Selection has to go through the CLI:
  # direct Dang calls don't apply the engine's filtered collection view. The
  # engine supplies its matching CLI.
  let selectedRun(ws: Workspace!, fixture: Directory!, args: [String!]!): Container! {
    container
      .from("alpine:3.23")
      # Workspace.search runs in the client: BusyBox grep can't serve it.
      .withExec(["apk", "add", "--no-cache", "ripgrep", "grep"])
      .withEnvVariable("NO_COLOR", "1")
      .withDirectory("/source", ws.directory("/", exclude: ["**/node_modules", "reporter/dist", ".git"]))
      .withDirectory("/work", fixture)
      .withNewFile("/work/.git/HEAD", "ref: refs/heads/main\n")
      .withNewFile("/work/dagger.toml", "[modules.playwright]\nsource = \"/source\"\n")
      .withWorkdir("/work")
      .withExec(
        ["/dev/.dagger/dagger", "--progress=report", "check", "--generated=false"] + args,
        expect: ANY,
        daggerInDaggerNewSession: true,
      )
  }

  # Assert a selected run's check totals and that its output holds messages.
  let selectedCheck(
    ws: Workspace!,
    fixture: Directory!,
    args: [String!]!,
    passed: Int!,
    failed: Int! = 0,
    messages: [String!]! = [],
  ): String! {
    let result = selectedRun(ws, fixture, args)
    let output = result.stdout + result.stderr
    assert((result.exitCode == 0) == (failed == 0), "unexpected check exit status:\n" + output)
    assert(checkSummaryMatches(output, passed, failed), "unexpected Dagger check totals:\n" + output)
    messages.map { message =>
      assert(output.contains(message), "missing " + message + ":\n" + output)
    }
    output
  }

  # Two projects, a and b, each with one.spec.ts and two.spec.ts, which pass,
  # and excluded.spec.ts, which fails if it runs. Every Playwright run starts
  # with a global setup that picks a run id the tests can see.
  let selectionFixture: Directory! {
    let header = "import { test, expect } from '@playwright/test';\n"
    ["a", "b"].reduce(directory) { dir, p =>
      dir
        .withNewFile(p + "/package.json", "{ \"name\": \"" + p + "\", \"private\": true, \"devDependencies\": { \"@playwright/test\": \"1.58.2\" } }\n")
        .withNewFile(p + "/playwright.config.ts", selectionConfig(""))
        .withNewFile(
          p + "/setup.ts",
          "export default async () => { process.env.RUN_ID = '" + p + "-' + Math.random().toString(36).slice(2); };\n",
        )
        .withNewFile(p + "/tests/one.spec.ts", header + "test('one', () => { expect(1).toBe(1); });\n")
        .withNewFile(p + "/tests/two.spec.ts", header + "test('two', () => { expect(2).toBe(2); });\n")
        .withNewFile(p + "/tests/excluded.spec.ts", header + "test('excluded', () => { throw new Error('excluded test ran'); });\n")
    }
  }

  # The fixture's playwright.config, with extra settings.
  let selectionConfig(extra: String!): String! {
    "import { defineConfig } from '@playwright/test';\nexport default defineConfig({ testDir: 'tests', globalSetup: './setup.ts'" + extra + " });\n"
  }

  let onlyOneAndTwo: [String!]! {
    ["--playwright-test-file=tests/one.spec.ts", "--playwright-test-file=tests/two.spec.ts"]
  }

  """
  Selected files run in every project, and files selected out don't run.
  """
  selectedFilesCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, selectionFixture, onlyOneAndTwo, passed: 4)
    null
  }

  """
  A project and a file selected together run just that file.
  """
  selectedProjectCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, selectionFixture, ["--playwright-project=a", "--playwright-test-file=tests/one.spec.ts"], passed: 1)
    null
  }

  """
  With nothing selected out, each project runs whole, and a failing file
  fails only its own check.
  """
  selectedWholeCheck(ws: Workspace!): Void @check {
    selectedCheck(
      ws,
      selectionFixture,
      [],
      passed: 4,
      failed: 2,
      messages: ["Playwright tests in a/tests/excluded.spec.ts: 1 failure", "excluded test ran"],
    )
    null
  }

  """
  Every selected file of a project shares one Playwright run.
  """
  selectedSharedRunCheck(ws: Workspace!): Void @check {
    # Each test fails with its run's id, so the messages show how many runs
    # there were: exactly one per project.
    let header = "import { test } from '@playwright/test';\n"
    let fixture = ["a", "b"].reduce(selectionFixture) { dir, p =>
      ["one", "two"].reduce(dir) { d, name =>
        d.withNewFile(
          p + "/tests/" + name + ".spec.ts",
          header + "test('" + name + "', () => { throw new Error('run-id=' + process.env.RUN_ID + '.'); });\n",
        )
      }
    }
    let output = selectedCheck(ws, fixture, onlyOneAndTwo, passed: 0, failed: 4)
    ["a", "b"].map { p =>
      let ids = output.matchAll(Regexp("run-id=(" + p + "-[a-z0-9]+)\\.")).map { m => m.captures[0] ?? "" }.uniq
      assert(ids.length == 1, "project " + p + " ran " + toString(ids.length) + " times: " + ids.join(", ") + "\n" + output)
    }
    null
  }

  """
  A failing global setup fails every selected file of its project, and only
  that project.
  """
  selectedSetupFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile("a/setup.ts", "export default async () => { throw new Error('setup exploded'); };\n")
    selectedCheck(ws, fixture, onlyOneAndTwo, passed: 2, failed: 2, messages: ["setup exploded"])
    null
  }

  """
  A file that fails to load fails its check, and the project's other
  selected files, which Playwright then doesn't run, fail as not run.
  """
  selectedLoadErrorCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile("a/tests/two.spec.ts", "import { test } from '@playwright/test';\ntest('two', () => { (( });\n")
    selectedCheck(
      ws,
      fixture,
      onlyOneAndTwo,
      passed: 2,
      failed: 2,
      messages: ["SyntaxError", "did not run: Playwright ran no test because tests/two.spec.ts failed to load"],
    )
    null
  }

  """
  A failure in a file no check covers fails every check of the run.
  """
  selectedOutsideFailureCheck(ws: Workspace!): Void @check {
    # A testMatch that isn't a literal is read as the default, so static
    # discovery misses hidden.e2e.ts, which Playwright runs and which fails.
    let fixture = selectionFixture
      .withNewFile(
        "a/playwright.config.ts",
        selectionConfig(", testMatch: process.env.NEVER ? [] : ['**/*.spec.ts', '**/*.e2e.ts']"),
      )
      .withNewFile("a/tests/excluded.spec.ts", "import { test } from '@playwright/test';\ntest('fine', () => {});\n")
      .withNewFile("a/tests/hidden.e2e.ts", "import { test } from '@playwright/test';\ntest('hidden', () => { throw new Error('hidden failure'); });\n")
    selectedCheck(
      ws,
      fixture,
      ["--playwright-project=a"],
      passed: 0,
      failed: 3,
      messages: ["failures outside the selected test files", "hidden failure"],
    )
    null
  }

  """
  A selected file Playwright doesn't run fails as not run instead of passing.
  """
  selectedNeverRanCheck(ws: Workspace!): Void @check {
    # A testIgnore that isn't a literal is read as ignoring nothing, so
    # excluded.spec.ts is a key that Playwright then ignores.
    let fixture = selectionFixture.withNewFile(
      "a/playwright.config.ts",
      selectionConfig(", testIgnore: process.env.NEVER ? [] : '**/excluded.spec.ts'"),
    )
    selectedCheck(
      ws,
      fixture,
      ["--playwright-project=a", "--playwright-test-file=tests/one.spec.ts", "--playwright-test-file=tests/excluded.spec.ts"],
      passed: 1,
      failed: 1,
      messages: ["Playwright tests in a/tests/excluded.spec.ts: did not run"],
    )
    null
  }

  """
  A project whose config can't be loaded fails alone, naming its config;
  listing still reads its files with Playwright's defaults.
  """
  selectedBrokenConfigCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile("a/playwright.config.ts", "this is {{ not ( javascript\n")
    selectedCheck(
      ws,
      fixture,
      onlyOneAndTwo,
      passed: 2,
      failed: 2,
      messages: ["before reporting any test; config a/playwright.config.ts", "SyntaxError"],
    )
    null
  }

  """
  Listing runs no install and no Playwright: a project whose install fails,
  and which has no Playwright at all, still lists its files.
  """
  selectedListingCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture
      .withNewFile(
        "a/package.json",
        "{ \"name\": \"a\", \"private\": true, \"scripts\": { \"preinstall\": \"exit 3\" }, \"devDependencies\": { \"@playwright/test\": \"0.0.0-does-not-exist\" } }\n",
      )
      .withNewFile("a/package-lock.json", "this is not a lockfile\n")
    let result = selectedRun(ws, fixture, ["-l", "--all"])
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "listing failed:\n" + output)
    let rows = output.split("\n").filter { line => line.containsMatch(`^playwright\s+a\s+tests/(?:one|two|excluded)\.spec\.ts\s+test\b`) }
    assert(rows.length == 3, "listing did not show project a's three files:\n" + output)
    assert(output.contains("npm install") == false, "listing ran an install:\n" + output)
    null
  }
}
